{
  "dsl_version": "1.0",
  "pipeline_key": "talking_head",
  "display_name": "Talking Head",
  "description": "Turn long on-camera footage — interviews, vlogs, lessons — into tight single-speaker shorts: find the complete thought, cut the dead air, caption it, and reframe around the person.",
  "version": "0.1.0",
  "category": "talking_head",
  "status": "beta",
  "default_language": "zh-CN",
  "entrypoint_stage_key": "intake",
  "supported_platforms": [
    "douyin",
    "kuaishou",
    "xiaohongshu",
    "bilibili",
    "wechat_channels",
    "youtube",
    "generic"
  ],
  "supported_aspect_ratios": [
    "9:16",
    "1:1",
    "16:9"
  ],
  "required_capabilities": [
    "asset_ingestion",
    "media_analysis",
    "speech_to_text",
    "clip_selection",
    "subtitle_generation",
    "clip_export",
    "storage"
  ],
  "optional_capabilities": [
    "video_composition",
    "audio_processing"
  ],
  "artifact_contracts": {
    "intake_brief": {
      "schema_key": "intake_brief.v1",
      "description": "Normalized source clipping request, goals, platform, duration, and format."
    },
    "source_media_review": {
      "schema_key": "source_media_review.v1",
      "description": "Uploaded on-camera footage, who is speaking, usage rights, and framing notes."
    },
    "media_analysis_report": {
      "schema_key": "media_analysis_report.v1",
      "description": "Source metadata, scenes, transcript, and analysis notes."
    },
    "clip_candidate_list": {
      "schema_key": "clip_candidate_list.v1",
      "description": "Candidate clip windows, scores, rationales, and review status."
    },
    "edit_plan": {
      "schema_key": "edit_plan.v1",
      "description": "Approved clip timeline, reframing, captions, audio, and export instructions."
    },
    "clip_export_manifest": {
      "schema_key": "clip_export_manifest.v1",
      "description": "Exported clip assets and per-clip render metadata."
    },
    "review_notes": {
      "schema_key": "review_notes.v1",
      "description": "Human review outcome and requested changes."
    },
    "publish_package": {
      "schema_key": "publish_package.v1",
      "description": "Downloadable clip package and access metadata."
    }
  },
  "metadata": {
    "clean_room": true,
    "roadmap_version": "P1",
    "product_surface": "script_to_video_service",
    "strategy_document": "docs/pipeline-strategies/talking_head.md",
    "supported_use_cases": [
      "interview_highlights",
      "course_clip_extraction",
      "founder_vlog_shorts",
      "webinar_speaker_cuts"
    ],
    "speaker_centered": true,
    "migration_policy": "Beta line. Shares the source-clipping kernel; only selection criteria and caption policy differ."
  },
  "stages": [
    {
      "stage_key": "intake",
      "display_name": "Speaker Intake",
      "description": "Normalize who is on camera, whether the original voice is kept, caption language, target clip count and duration, and where the person sits in frame.",
      "order": 1,
      "depends_on_stage_keys": [],
      "input_artifacts": [],
      "output_artifacts": [
        {
          "artifact_type": "intake_brief",
          "schema_key": "intake_brief.v1"
        }
      ],
      "tool_requirements": [],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Brief records the speaker, caption language, and framing intent.",
        "Target clip count, duration, and aspect ratio are normalized."
      ],
      "required_input_artifacts": [],
      "output_artifact_types": [
        "intake_brief"
      ],
      "required_capabilities": [],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 120
    },
    {
      "stage_key": "source_ingest",
      "display_name": "Footage Review",
      "description": "Register the on-camera source clips and confirm a single identifiable speaker, usable audio, and usage rights before any cut is proposed.",
      "order": 2,
      "depends_on_stage_keys": [
        "intake"
      ],
      "input_artifacts": [
        {
          "artifact_type": "intake_brief",
          "schema_key": "intake_brief.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "source_media_review",
          "schema_key": "source_media_review.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "asset_ingestion",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": [
          "source media present",
          "usage rights",
          "target clip count",
          "clip duration",
          "platform fit"
        ],
        "success_criteria": [
          "Sources are registered or the missing source blocker is explicit."
        ]
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Sources are registered, or the missing speaker/audio blocker is explicit."
      ],
      "required_input_artifacts": [
        "intake_brief"
      ],
      "output_artifact_types": [
        "source_media_review"
      ],
      "required_capabilities": [
        "asset_ingestion"
      ],
      "optional_capabilities": [],
      "requires_human_review": true,
      "timeout_seconds": 300,
      "review_focus": [
        "one identifiable speaker",
        "usable sync audio",
        "usage rights",
        "framing and headroom",
        "target clip count"
      ]
    },
    {
      "stage_key": "analysis",
      "display_name": "Speech and Shot Analysis",
      "description": "Probe media metadata, sample frames, detect shot boundaries, and transcribe speech with word-free but sentence-level timing for cut planning.",
      "order": 3,
      "depends_on_stage_keys": [
        "source_ingest"
      ],
      "input_artifacts": [
        {
          "artifact_type": "source_media_review",
          "schema_key": "source_media_review.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "media_analysis_report",
          "schema_key": "media_analysis_report.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "media_analysis",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        },
        {
          "capability": "speech_to_text",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Analysis report records metadata, shot boundaries, and transcript status.",
        "Placeholder transcripts are flagged as placeholders, never presented as ASR output."
      ],
      "required_input_artifacts": [
        "source_media_review"
      ],
      "output_artifact_types": [
        "media_analysis_report"
      ],
      "required_capabilities": [
        "media_analysis",
        "speech_to_text"
      ],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 900
    },
    {
      "stage_key": "clip_selection",
      "display_name": "Moment Selection",
      "description": "Score candidate windows on three axes — is the thought complete, is the opening a hook, and how much dead air or verbal stumble sits inside — then send the shortlist to a human.",
      "order": 4,
      "depends_on_stage_keys": [
        "analysis"
      ],
      "input_artifacts": [
        {
          "artifact_type": "source_media_review",
          "schema_key": "source_media_review.v1"
        },
        {
          "artifact_type": "media_analysis_report",
          "schema_key": "media_analysis_report.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "clip_candidate_list",
          "schema_key": "clip_candidate_list.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "clip_selection",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": [
          "candidate relevance",
          "hook strength",
          "rights and sensitivity",
          "target duration",
          "platform fit"
        ],
        "success_criteria": [
          "Reviewer can approve, reject, or request new candidates."
        ]
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Every candidate records start/end, the three scores, and a one-line rationale."
      ],
      "required_input_artifacts": [
        "source_media_review",
        "media_analysis_report"
      ],
      "output_artifact_types": [
        "clip_candidate_list"
      ],
      "required_capabilities": [
        "clip_selection"
      ],
      "optional_capabilities": [],
      "requires_human_review": true,
      "timeout_seconds": 600,
      "review_focus": [
        "complete thought per clip",
        "hook in the first seconds",
        "dead air and verbal stumbles",
        "speaker stays framed",
        "target duration"
      ]
    },
    {
      "stage_key": "edit",
      "display_name": "Cut, Caption, Reframe",
      "description": "Assemble approved windows, cut silence, burn captions in the target language, normalize loudness, and pick a reframing box that keeps the speaker centered.",
      "order": 5,
      "depends_on_stage_keys": [
        "clip_selection"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_candidate_list",
          "schema_key": "clip_candidate_list.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "edit_plan",
          "schema_key": "edit_plan.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "subtitle_generation",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        },
        {
          "capability": "video_composition",
          "required": false,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        },
        {
          "capability": "audio_processing",
          "required": false,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Edit plan states cut points, caption mode, reframing box, and loudness target."
      ],
      "required_input_artifacts": [
        "clip_candidate_list"
      ],
      "output_artifact_types": [
        "edit_plan"
      ],
      "required_capabilities": [
        "subtitle_generation"
      ],
      "optional_capabilities": [
        "video_composition",
        "audio_processing"
      ],
      "requires_human_review": false,
      "timeout_seconds": 300
    },
    {
      "stage_key": "export_clips",
      "display_name": "Export Speaker Clips",
      "description": "Export approved windows with captions burned in. Export is planned and not auto-dispatched, matching the clip-factory contract.",
      "order": 6,
      "depends_on_stage_keys": [
        "edit"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_candidate_list",
          "schema_key": "clip_candidate_list.v1"
        },
        {
          "artifact_type": "edit_plan",
          "schema_key": "edit_plan.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "clip_export_manifest",
          "schema_key": "clip_export_manifest.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "clip_export",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "stage_manifest",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage_tool"
      },
      "success_criteria": [
        "Clip export manifest exists or the export blocker is explicit."
      ],
      "required_input_artifacts": [
        "clip_candidate_list",
        "edit_plan"
      ],
      "output_artifact_types": [
        "clip_export_manifest"
      ],
      "required_capabilities": [
        "clip_export"
      ],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 1800
    },
    {
      "stage_key": "final_review",
      "display_name": "Speaker Clip Review",
      "description": "Review cut points, caption coverage, and framing before packaging.",
      "order": 7,
      "depends_on_stage_keys": [
        "export_clips"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_export_manifest",
          "schema_key": "clip_export_manifest.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "review_notes",
          "schema_key": "review_notes.v1"
        }
      ],
      "tool_requirements": [],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": [
          "clip quality",
          "cut points",
          "captions",
          "rights",
          "platform fit"
        ],
        "success_criteria": [
          "Final clips are approved for packaging or concrete fixes are recorded."
        ]
      },
      "dispatch_policy": {
        "mode": "human_gate",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Review notes record approval or requested fixes."
      ],
      "required_input_artifacts": [
        "clip_export_manifest"
      ],
      "output_artifact_types": [
        "review_notes"
      ],
      "required_capabilities": [],
      "optional_capabilities": [],
      "requires_human_review": true,
      "skippable": true,
      "skip_policy": {
        "allowed_when": "clip_export_manifest_exists",
        "reason_required": true,
        "creates_artifact": "review_notes"
      },
      "timeout_seconds": 86400,
      "review_focus": [
        "clip quality",
        "cut points",
        "caption accuracy",
        "speaker framing",
        "platform fit"
      ]
    },
    {
      "stage_key": "publish",
      "display_name": "Package Speaker Clips",
      "description": "Create the final clip package with per-clip caption and framing metadata.",
      "order": 8,
      "depends_on_stage_keys": [
        "final_review"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_export_manifest",
          "schema_key": "clip_export_manifest.v1"
        },
        {
          "artifact_type": "review_notes",
          "schema_key": "review_notes.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "publish_package",
          "schema_key": "publish_package.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "storage",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "stage_manifest",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage_tool"
      },
      "success_criteria": [
        "Publish package contains clip export metadata and access link placeholders."
      ],
      "required_input_artifacts": [
        "clip_export_manifest",
        "review_notes"
      ],
      "output_artifact_types": [
        "publish_package"
      ],
      "required_capabilities": [
        "storage"
      ],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 600
    }
  ]
}
