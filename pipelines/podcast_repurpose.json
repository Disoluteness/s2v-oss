{
  "dsl_version": "1.0",
  "pipeline_key": "podcast_repurpose",
  "display_name": "Podcast Repurpose",
  "description": "Turn a long audio episode into short vertical videos: transcribe, find self-contained moments, design a minimal visual layer, caption, and export.",
  "version": "0.1.0",
  "category": "podcast_repurpose",
  "status": "beta",
  "default_language": "zh-CN",
  "entrypoint_stage_key": "intake",
  "supported_platforms": [
    "douyin",
    "kuaishou",
    "xiaohongshu",
    "bilibili",
    "wechat_channels",
    "youtube",
    "generic"
  ],
  "supported_aspect_ratios": [
    "9:16",
    "1:1"
  ],
  "required_capabilities": [
    "asset_ingestion",
    "media_analysis",
    "speech_to_text",
    "clip_selection",
    "clip_export",
    "storage"
  ],
  "optional_capabilities": [
    "subtitle_generation",
    "image_generation",
    "video_composition",
    "audio_processing"
  ],
  "artifact_contracts": {
    "intake_brief": {
      "schema_key": "intake_brief.v1",
      "description": "Normalized source clipping request, goals, platform, duration, and format."
    },
    "source_media_review": {
      "schema_key": "source_media_review.v1",
      "description": "Uploaded audio episodes or links, speaker line-up, and usage rights."
    },
    "media_analysis_report": {
      "schema_key": "media_analysis_report.v1",
      "description": "Audio metadata, loudness profile, transcript segments, and topic boundaries."
    },
    "clip_candidate_list": {
      "schema_key": "clip_candidate_list.v1",
      "description": "Candidate clip windows, scores, rationales, and review status."
    },
    "edit_plan": {
      "schema_key": "edit_plan.v1",
      "description": "Approved clip timeline, reframing, captions, audio, and export instructions."
    },
    "clip_export_manifest": {
      "schema_key": "clip_export_manifest.v1",
      "description": "Exported clip assets and per-clip render metadata."
    },
    "review_notes": {
      "schema_key": "review_notes.v1",
      "description": "Human review outcome and requested changes."
    },
    "publish_package": {
      "schema_key": "publish_package.v1",
      "description": "Downloadable clip package and access metadata."
    }
  },
  "metadata": {
    "clean_room": true,
    "roadmap_version": "P1",
    "product_surface": "script_to_video_service",
    "strategy_document": "docs/pipeline-strategies/podcast_repurpose.md",
    "supported_use_cases": [
      "podcast_episode_to_shorts",
      "interview_audio_clips",
      "audio_newsletter_video",
      "talk_track_highlights"
    ],
    "audio_first": true,
    "migration_policy": "Beta line. Audio-only ingest; the visual layer is deliberately minimal."
  },
  "stages": [
    {
      "stage_key": "intake",
      "display_name": "Episode Intake",
      "description": "Normalize episode length, desired clip count, target duration, caption language, and whether an existing cover image or brand frame should be used.",
      "order": 1,
      "depends_on_stage_keys": [],
      "input_artifacts": [],
      "output_artifacts": [
        {
          "artifact_type": "intake_brief",
          "schema_key": "intake_brief.v1"
        }
      ],
      "tool_requirements": [],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Brief records episode length, clip count, caption language, and visual style."
      ],
      "required_input_artifacts": [],
      "output_artifact_types": [
        "intake_brief"
      ],
      "required_capabilities": [],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 120
    },
    {
      "stage_key": "source_ingest",
      "display_name": "Episode Review",
      "description": "Register the audio source and confirm speaker count, language, and usage rights. Audio-only input is expected; missing audio is an explicit blocker, not a degraded run.",
      "order": 2,
      "depends_on_stage_keys": [
        "intake"
      ],
      "input_artifacts": [
        {
          "artifact_type": "intake_brief",
          "schema_key": "intake_brief.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "source_media_review",
          "schema_key": "source_media_review.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "asset_ingestion",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": [
          "source media present",
          "usage rights",
          "target clip count",
          "clip duration",
          "platform fit"
        ],
        "success_criteria": [
          "Sources are registered or the missing source blocker is explicit."
        ]
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Episode audio is registered, or the missing-audio blocker is explicit."
      ],
      "required_input_artifacts": [
        "intake_brief"
      ],
      "output_artifact_types": [
        "source_media_review"
      ],
      "required_capabilities": [
        "asset_ingestion"
      ],
      "optional_capabilities": [],
      "requires_human_review": true,
      "timeout_seconds": 300,
      "review_focus": [
        "audio present and audible",
        "speaker count and language",
        "usage rights",
        "target clip count",
        "visual style"
      ]
    },
    {
      "stage_key": "analysis",
      "display_name": "Transcribe and Segment",
      "description": "Probe loudness and duration, transcribe the episode, and cut the transcript into topic-coherent segments. Without a real transcript this pipeline cannot select meaningful moments, so transcription is a hard requirement here.",
      "order": 3,
      "depends_on_stage_keys": [
        "source_ingest"
      ],
      "input_artifacts": [
        {
          "artifact_type": "source_media_review",
          "schema_key": "source_media_review.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "media_analysis_report",
          "schema_key": "media_analysis_report.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "media_analysis",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        },
        {
          "capability": "speech_to_text",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Transcript segments exist with start/end times and topic labels.",
        "Placeholder transcripts fail the stage instead of silently producing empty clips."
      ],
      "required_input_artifacts": [
        "source_media_review"
      ],
      "output_artifact_types": [
        "media_analysis_report"
      ],
      "required_capabilities": [
        "media_analysis",
        "speech_to_text"
      ],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 900
    },
    {
      "stage_key": "clip_selection",
      "display_name": "Moment Selection",
      "description": "Pick segment windows that stand alone: a question answered, a claim supported, a story finished. Prefer quotable density over raw volume.",
      "order": 4,
      "depends_on_stage_keys": [
        "analysis"
      ],
      "input_artifacts": [
        {
          "artifact_type": "source_media_review",
          "schema_key": "source_media_review.v1"
        },
        {
          "artifact_type": "media_analysis_report",
          "schema_key": "media_analysis_report.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "clip_candidate_list",
          "schema_key": "clip_candidate_list.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "clip_selection",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": [
          "candidate relevance",
          "hook strength",
          "rights and sensitivity",
          "target duration",
          "platform fit"
        ],
        "success_criteria": [
          "Reviewer can approve, reject, or request new candidates."
        ]
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Each candidate maps to transcript segment boundaries and carries a rationale."
      ],
      "required_input_artifacts": [
        "source_media_review",
        "media_analysis_report"
      ],
      "output_artifact_types": [
        "clip_candidate_list"
      ],
      "required_capabilities": [
        "clip_selection"
      ],
      "optional_capabilities": [],
      "requires_human_review": true,
      "timeout_seconds": 600,
      "review_focus": [
        "self-contained meaning",
        "quotable density",
        "no mid-sentence start",
        "target duration",
        "topic fit"
      ]
    },
    {
      "stage_key": "edit",
      "display_name": "Visual Layer and Captions",
      "description": "Design the minimal visual layer — cover frame, waveform or still background, speaker label — and place captions for silent viewing.",
      "order": 5,
      "depends_on_stage_keys": [
        "clip_selection"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_candidate_list",
          "schema_key": "clip_candidate_list.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "edit_plan",
          "schema_key": "edit_plan.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "image_generation",
          "required": false,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        },
        {
          "capability": "subtitle_generation",
          "required": false,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        },
        {
          "capability": "video_composition",
          "required": false,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        },
        {
          "capability": "audio_processing",
          "required": false,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "agent_runner",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Edit plan records the background asset, caption mode, and per-clip safe area."
      ],
      "required_input_artifacts": [
        "clip_candidate_list"
      ],
      "output_artifact_types": [
        "edit_plan"
      ],
      "required_capabilities": [],
      "optional_capabilities": [
        "image_generation",
        "subtitle_generation",
        "video_composition",
        "audio_processing"
      ],
      "requires_human_review": false,
      "timeout_seconds": 300
    },
    {
      "stage_key": "export_clips",
      "display_name": "Export Audio Clips",
      "description": "Export approved windows as video files with the designed visual layer. Export is planned and not auto-dispatched.",
      "order": 6,
      "depends_on_stage_keys": [
        "edit"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_candidate_list",
          "schema_key": "clip_candidate_list.v1"
        },
        {
          "artifact_type": "edit_plan",
          "schema_key": "edit_plan.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "clip_export_manifest",
          "schema_key": "clip_export_manifest.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "clip_export",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "stage_manifest",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage_tool"
      },
      "success_criteria": [
        "Clip export manifest exists or the export blocker is explicit."
      ],
      "required_input_artifacts": [
        "clip_candidate_list",
        "edit_plan"
      ],
      "output_artifact_types": [
        "clip_export_manifest"
      ],
      "required_capabilities": [
        "clip_export"
      ],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 1800
    },
    {
      "stage_key": "final_review",
      "display_name": "Episode Clip Review",
      "description": "Review meaning preservation, caption accuracy, and audio clarity.",
      "order": 7,
      "depends_on_stage_keys": [
        "export_clips"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_export_manifest",
          "schema_key": "clip_export_manifest.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "review_notes",
          "schema_key": "review_notes.v1"
        }
      ],
      "tool_requirements": [],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": [
          "clip quality",
          "cut points",
          "captions",
          "rights",
          "platform fit"
        ],
        "success_criteria": [
          "Final clips are approved for packaging or concrete fixes are recorded."
        ]
      },
      "dispatch_policy": {
        "mode": "human_gate",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage"
      },
      "success_criteria": [
        "Review notes record approval or requested fixes."
      ],
      "required_input_artifacts": [
        "clip_export_manifest"
      ],
      "output_artifact_types": [
        "review_notes"
      ],
      "required_capabilities": [],
      "optional_capabilities": [],
      "requires_human_review": true,
      "skippable": true,
      "skip_policy": {
        "allowed_when": "clip_export_manifest_exists",
        "reason_required": true,
        "creates_artifact": "review_notes"
      },
      "timeout_seconds": 86400,
      "review_focus": [
        "meaning preserved after the cut",
        "caption accuracy",
        "audio clarity",
        "visual layer does not distract",
        "platform fit"
      ]
    },
    {
      "stage_key": "publish",
      "display_name": "Package Episode Clips",
      "description": "Create the clip package with transcript excerpts and episode attribution.",
      "order": 8,
      "depends_on_stage_keys": [
        "final_review"
      ],
      "input_artifacts": [
        {
          "artifact_type": "clip_export_manifest",
          "schema_key": "clip_export_manifest.v1"
        },
        {
          "artifact_type": "review_notes",
          "schema_key": "review_notes.v1"
        }
      ],
      "output_artifacts": [
        {
          "artifact_type": "publish_package",
          "schema_key": "publish_package.v1"
        }
      ],
      "tool_requirements": [
        {
          "capability": "storage",
          "required": true,
          "selector_policy": "best_available",
          "dispatch_policy": "planned"
        }
      ],
      "review_policy": {
        "required": false,
        "gate_type": "none",
        "required_before_next_stage": false
      },
      "dispatch_policy": {
        "mode": "stage_manifest",
        "auto_dispatch_required_tools": false,
        "idempotency_scope": "run_stage_tool"
      },
      "success_criteria": [
        "Publish package contains clip export metadata and access link placeholders."
      ],
      "required_input_artifacts": [
        "clip_export_manifest",
        "review_notes"
      ],
      "output_artifact_types": [
        "publish_package"
      ],
      "required_capabilities": [
        "storage"
      ],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 600
    }
  ]
}
