{
  "dsl_version": "1.0",
  "pipeline_key": "source_clip_factory",
  "display_name": "Source Clip Factory",
  "description": "Create short clips from long source videos or batches of uploaded media using ingest, analysis, candidate selection, review, and export stages.",
  "version": "0.4.0",
  "category": "source_clip_factory",
  "status": "beta",
  "default_language": "zh-CN",
  "entrypoint_stage_key": "intake",
  "supported_platforms": ["douyin", "kuaishou", "xiaohongshu", "bilibili", "wechat_channels", "generic"],
  "supported_aspect_ratios": ["9:16", "1:1", "16:9"],
  "required_capabilities": ["asset_ingestion", "media_analysis", "clip_selection", "clip_export", "storage"],
  "optional_capabilities": ["speech_to_text", "subtitle_generation", "video_composition", "audio_processing"],
  "artifact_contracts": {
    "intake_brief": {"schema_key": "intake_brief.v1", "description": "Normalized source clipping request, goals, platform, duration, and format."},
    "source_media_review": {"schema_key": "source_media_review.v1", "description": "Uploaded source media, links, ingest notes, and manual source context."},
    "media_analysis_report": {"schema_key": "media_analysis_report.v1", "description": "Source metadata, scenes, transcript, and analysis notes."},
    "clip_candidate_list": {"schema_key": "clip_candidate_list.v1", "description": "Candidate clip windows, scores, rationales, and review status."},
    "edit_plan": {"schema_key": "edit_plan.v1", "description": "Approved clip timeline, reframing, captions, audio, and export instructions."},
    "clip_export_manifest": {"schema_key": "clip_export_manifest.v1", "description": "Exported clip assets and per-clip render metadata."},
    "review_notes": {"schema_key": "review_notes.v1", "description": "Human review outcome and requested changes."},
    "publish_package": {"schema_key": "publish_package.v1", "description": "Downloadable clip package and access metadata."}
  },
  "metadata": {
    "clean_room": true,
    "roadmap_version": "V3.3",
    "product_surface": "script_to_video_service",
    "strategy_document": "docs/pipeline-strategies/source_clip_factory.md",
    "supported_use_cases": [
      "long_video_to_short_clips",
      "webinar_highlights",
      "product_demo_clips",
      "multi_asset_clip_batch"
    ],
    "analysis_maturity": "metadata_and_interval_frame_sampling",
    "migration_policy": "This beta pipeline validates source-media orchestration before deeper V4 media understanding and V5 render automation."
  },
  "stages": [
    {
      "stage_key": "intake",
      "display_name": "Clip Factory Intake",
      "description": "Normalize source clip goals, target platform, clip duration, aspect ratio, and selection criteria.",
      "order": 1,
      "depends_on_stage_keys": [],
      "input_artifacts": [],
      "output_artifacts": [{"artifact_type": "intake_brief", "schema_key": "intake_brief.v1"}],
      "tool_requirements": [],
      "review_policy": {"required": false, "gate_type": "none", "required_before_next_stage": false},
      "dispatch_policy": {"mode": "agent_runner", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage"},
      "success_criteria": ["Brief preserves the source clipping request.", "Platform, clip duration, and aspect ratio are normalized."],
      "required_input_artifacts": [],
      "output_artifact_types": ["intake_brief"],
      "required_capabilities": [],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 120
    },
    {
      "stage_key": "source_ingest",
      "display_name": "Source Media Review",
      "description": "Register uploaded source media or links and capture manual source context before analysis.",
      "order": 2,
      "depends_on_stage_keys": ["intake"],
      "input_artifacts": [{"artifact_type": "intake_brief", "schema_key": "intake_brief.v1"}],
      "output_artifacts": [{"artifact_type": "source_media_review", "schema_key": "source_media_review.v1"}],
      "tool_requirements": [{"capability": "asset_ingestion", "required": true, "selector_policy": "best_available", "dispatch_policy": "planned"}],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": ["source media present", "usage rights", "target clip count", "clip duration", "platform fit"],
        "success_criteria": ["Sources are registered or the missing source blocker is explicit."]
      },
      "dispatch_policy": {"mode": "agent_runner", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage"},
      "success_criteria": ["Source media review records uploaded assets, links, or missing input notes."],
      "required_input_artifacts": ["intake_brief"],
      "output_artifact_types": ["source_media_review"],
      "required_capabilities": ["asset_ingestion"],
      "optional_capabilities": [],
      "requires_human_review": true,
      "timeout_seconds": 300
    },
    {
      "stage_key": "analysis",
      "display_name": "Media Analysis",
      "description": "Probe source metadata and prepare scene/transcript notes for clip selection.",
      "order": 3,
      "depends_on_stage_keys": ["source_ingest"],
      "input_artifacts": [{"artifact_type": "source_media_review", "schema_key": "source_media_review.v1"}],
      "output_artifacts": [{"artifact_type": "media_analysis_report", "schema_key": "media_analysis_report.v1"}],
      "tool_requirements": [
        {"capability": "media_analysis", "required": true, "selector_policy": "best_available", "dispatch_policy": "planned"},
        {"capability": "speech_to_text", "required": false, "selector_policy": "best_available", "dispatch_policy": "planned"}
      ],
      "review_policy": {"required": false, "gate_type": "none", "required_before_next_stage": false},
      "dispatch_policy": {"mode": "agent_runner", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage"},
      "success_criteria": ["Analysis report records media metadata, scene notes, and transcript availability."],
      "required_input_artifacts": ["source_media_review"],
      "output_artifact_types": ["media_analysis_report"],
      "required_capabilities": ["media_analysis"],
      "optional_capabilities": ["speech_to_text"],
      "requires_human_review": false,
      "timeout_seconds": 900
    },
    {
      "stage_key": "clip_selection",
      "display_name": "Clip Candidate Selection",
      "description": "Select candidate short clips from the media analysis report for human review.",
      "order": 4,
      "depends_on_stage_keys": ["analysis"],
      "input_artifacts": [
        {"artifact_type": "source_media_review", "schema_key": "source_media_review.v1"},
        {"artifact_type": "media_analysis_report", "schema_key": "media_analysis_report.v1"}
      ],
      "output_artifacts": [{"artifact_type": "clip_candidate_list", "schema_key": "clip_candidate_list.v1"}],
      "tool_requirements": [{"capability": "clip_selection", "required": true, "selector_policy": "best_available", "dispatch_policy": "planned"}],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": ["candidate relevance", "hook strength", "rights and sensitivity", "target duration", "platform fit"],
        "success_criteria": ["Reviewer can approve, reject, or request new candidates."]
      },
      "dispatch_policy": {"mode": "agent_runner", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage"},
      "success_criteria": ["Candidate list records clip windows, rationales, and review status."],
      "required_input_artifacts": ["source_media_review", "media_analysis_report"],
      "output_artifact_types": ["clip_candidate_list"],
      "required_capabilities": ["clip_selection"],
      "optional_capabilities": [],
      "requires_human_review": true,
      "timeout_seconds": 600
    },
    {
      "stage_key": "edit",
      "display_name": "Clip Edit Plan",
      "description": "Create approved clip timelines, reframing choices, caption instructions, and export settings.",
      "order": 5,
      "depends_on_stage_keys": ["clip_selection"],
      "input_artifacts": [{"artifact_type": "clip_candidate_list", "schema_key": "clip_candidate_list.v1"}],
      "output_artifacts": [{"artifact_type": "edit_plan", "schema_key": "edit_plan.v1"}],
      "tool_requirements": [
        {"capability": "subtitle_generation", "required": false, "selector_policy": "best_available", "dispatch_policy": "planned"},
        {"capability": "video_composition", "required": false, "selector_policy": "best_available", "dispatch_policy": "planned"},
        {"capability": "audio_processing", "required": false, "selector_policy": "best_available", "dispatch_policy": "planned"}
      ],
      "review_policy": {"required": false, "gate_type": "none", "required_before_next_stage": false},
      "dispatch_policy": {"mode": "agent_runner", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage"},
      "success_criteria": ["Edit plan records approved clips, caption options, and export profile."],
      "required_input_artifacts": ["clip_candidate_list"],
      "output_artifact_types": ["edit_plan"],
      "required_capabilities": [],
      "optional_capabilities": ["subtitle_generation", "video_composition", "audio_processing"],
      "requires_human_review": false,
      "timeout_seconds": 300
    },
    {
      "stage_key": "export_clips",
      "display_name": "Export Clips",
      "description": "Export approved clip windows. In V3 this is planned but not auto-dispatched until export worker payloads are implemented.",
      "order": 6,
      "depends_on_stage_keys": ["edit"],
      "input_artifacts": [
        {"artifact_type": "clip_candidate_list", "schema_key": "clip_candidate_list.v1"},
        {"artifact_type": "edit_plan", "schema_key": "edit_plan.v1"}
      ],
      "output_artifacts": [{"artifact_type": "clip_export_manifest", "schema_key": "clip_export_manifest.v1"}],
      "tool_requirements": [{"capability": "clip_export", "required": true, "selector_policy": "best_available", "dispatch_policy": "planned"}],
      "review_policy": {"required": false, "gate_type": "none", "required_before_next_stage": false},
      "dispatch_policy": {"mode": "stage_manifest", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage_tool"},
      "success_criteria": ["Clip export manifest exists or the export blocker is explicit."],
      "required_input_artifacts": ["clip_candidate_list", "edit_plan"],
      "output_artifact_types": ["clip_export_manifest"],
      "required_capabilities": ["clip_export"],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 1800
    },
    {
      "stage_key": "final_review",
      "display_name": "Final Clip Review",
      "description": "Review exported or planned clips before publishing.",
      "order": 7,
      "depends_on_stage_keys": ["export_clips"],
      "input_artifacts": [{"artifact_type": "clip_export_manifest", "schema_key": "clip_export_manifest.v1"}],
      "output_artifacts": [{"artifact_type": "review_notes", "schema_key": "review_notes.v1"}],
      "tool_requirements": [],
      "review_policy": {
        "required": true,
        "gate_type": "human_review",
        "required_before_next_stage": true,
        "review_focus": ["clip quality", "cut points", "captions", "rights", "platform fit"],
        "success_criteria": ["Final clips are approved for packaging or concrete fixes are recorded."]
      },
      "dispatch_policy": {"mode": "human_gate", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage"},
      "success_criteria": ["Review notes record approval or requested fixes."],
      "required_input_artifacts": ["clip_export_manifest"],
      "output_artifact_types": ["review_notes"],
      "required_capabilities": [],
      "optional_capabilities": [],
      "requires_human_review": true,
      "skippable": true,
      "skip_policy": {
        "allowed_when": "clip_export_manifest_exists",
        "reason_required": true,
        "creates_artifact": "review_notes"
      },
      "timeout_seconds": 86400
    },
    {
      "stage_key": "publish",
      "display_name": "Publish Clip Package",
      "description": "Create the final clip package and access metadata.",
      "order": 8,
      "depends_on_stage_keys": ["final_review"],
      "input_artifacts": [
        {"artifact_type": "clip_export_manifest", "schema_key": "clip_export_manifest.v1"},
        {"artifact_type": "review_notes", "schema_key": "review_notes.v1"}
      ],
      "output_artifacts": [{"artifact_type": "publish_package", "schema_key": "publish_package.v1"}],
      "tool_requirements": [{"capability": "storage", "required": true, "selector_policy": "best_available", "dispatch_policy": "planned"}],
      "review_policy": {"required": false, "gate_type": "none", "required_before_next_stage": false},
      "dispatch_policy": {"mode": "stage_manifest", "auto_dispatch_required_tools": false, "idempotency_scope": "run_stage_tool"},
      "success_criteria": ["Publish package contains clip export metadata and access link placeholders."],
      "required_input_artifacts": ["clip_export_manifest", "review_notes"],
      "output_artifact_types": ["publish_package"],
      "required_capabilities": ["storage"],
      "optional_capabilities": [],
      "requires_human_review": false,
      "timeout_seconds": 600
    }
  ]
}
