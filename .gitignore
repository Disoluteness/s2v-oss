.DS_Store
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
.next/
coverage/
storage/
tmp/
# 本地测试用的临时目录（沙箱里临时目录不可写时，测试走这里）
.tmp/
# 本地沙箱的 tempfile 探测残留：根目录下 8 位小写字母数字、无扩展名、4 字节的空探针文件。
# 不是项目产物，可以放心删除；这条规则防止 `git add .` 把它们带进提交。
# 例外是同样 8 个字符的真实目录，避免误伤。
/[a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9]
!/examples/
!/packages/

# ── 敏感：绝不提交 ──────────────────────────────
# 本地 AI 工具工作记忆（含内网 IP / 本地路径 / 参考项目路径 / 密钥决策）
.workbuddy/
# 运行数据库（含真实数据；本地调试产生的 sqlite 也一并忽略）
*.db
*.sqlite
*.sqlite3
.pytest_tmp/
# 开发工作笔记（含本地路径与内网 IP，开源用户不需要；决策记录见 docs/DECISIONS.md）
docs/CURRENT_CONTEXT.md
docs/TASK_BOARD.md
# Mac 垃圾文件
__MACOSX/

# idea
.idea/**
# pytest 沙箱运行残留：原名直接拼 6 位随机后缀的测试文件副本
*.py[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]

# 个人推送脚本（含两个远程的个人配置，不入开源仓）
push.sh

# 沙箱写副本复发覆盖：md / html 同款 6 位随机后缀
*.md[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]
*.html[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]
