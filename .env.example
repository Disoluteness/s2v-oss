APP_ENV=local
APP_NAME=script2video-studio
API_HOST=0.0.0.0
API_PORT=8080

DATABASE_URL=mysql+pymysql://script2video:script2video@mysql:3306/script2video?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=script2video
LOCAL_STORAGE_ROOT=storage
ASSET_LINK_SECRET=dev-only-change-me
ASSET_LINK_DEFAULT_TTL_SECONDS=600
# Required only when provider jobs need to fetch locally stored assets.
# Example: https://studio.example.com or http://localhost:18080
PUBLIC_BASE_URL=

WORKER_BATCH_SIZE=5
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_SECONDS=300
WORKER_ID=
WORKER_LOG_LEVEL=INFO

# --- Worker scaling (V8.1) ---------------------------------------------------
# ROLE splits a worker fleet by job lane: "all" (default) claims every queue,
# or one of provider / analysis / media / render to dedicate an instance to a
# lane (e.g. keep ffmpeg-heavy render work off the provider-polling worker).
# The reaper fails jobs stuck in `running` longer than WORKER_JOB_TIMEOUT_
# SECONDS (waiting_provider is exempt — provider polls are slow by design).
# Automatic retries back off exponentially between BASE and CAP seconds, and
# only for local tool steps: paid provider submissions are never retried
# unattended. Changes here require rebuilding the worker image.
WORKER_ROLE=all
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKER_REAP_INTERVAL_SECONDS=60
WORKER_RETRY_BACKOFF_BASE_SECONDS=30
WORKER_RETRY_BACKOFF_CAP_SECONDS=3600

# Provider keys are optional until their adapters are enabled.
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com
# 音频驱动的数字人对口型。EMO（emo-v1）已从百炼下线，万相-数字人（wan2.2-s2v）是替代品；
# 适配器按模型名前缀选方言，把 MODEL 改回 emo 开头即回到旧协议（需要人脸检测那一步）。
# wan2.2-s2v 要求输入音频短于 20 秒、小于 15MB —— 长口播脚本需要先切段。
DASHSCOPE_AVATAR_MODEL=wan2.2-s2v
DASHSCOPE_AVATAR_RESOLUTION=480P
# 以下三项只有 EMO 方言用得到。
DASHSCOPE_AVATAR_DETECT_MODEL=emo-detect-v1
DASHSCOPE_AVATAR_RATIO=3:4
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro
DASHSCOPE_IMAGE_SIZE=1024*1024
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MUSIC_ENDPOINT=/v1/music

# Planner defaults to local deterministic JSON generation so development runs
# do not accidentally spend API credits. Set to "dashscope" to use DashScope.
SCRIPT2VIDEO_PLANNER_PROVIDER=rule_based
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=qwen-plus

# --- Identity / permissions (V6.5) -----------------------------------------
# Requests carry their identity in a trusted header injected by the gateway.
# "open" trusts X-Actor-Id outright (fine for a single internal deployment);
# "secret" only honours it when X-Actor-Secret matches ACTOR_HEADER_SECRET, and
# with no secret configured it trusts nobody. Either way, a request with no
# identity falls back to DEFAULT_ACTOR_ID, which is auto-registered as the owner
# of the default team — that is what keeps existing unauthenticated callers and
# the deployment gate working unchanged.
# Switch to "secret" before exposing the API beyond the internal gateway.
ACTOR_TRUST_MODE=open
ACTOR_HEADER_SECRET=
DEFAULT_ACTOR_ID=system
DEFAULT_ACTOR_NAME=Internal System
DEFAULT_TEAM_SLUG=default
DEFAULT_TEAM_NAME=Default Team

# --- API contract (V7.1) ---------------------------------------------------
# How long a recorded Idempotency-Key response stays replayable. After this the
# key is free again and the row is a candidate for purge. Requests that send no
# Idempotency-Key header are unaffected by this setting.
IDEMPOTENCY_TTL_SECONDS=86400

# --- Programmatic credentials (V7.2) ---------------------------------------
# Salt for the API key hash. The stored value is SHA-256(pepper + plaintext), so
# CHANGING THIS INVALIDATES EVERY KEY ALREADY ISSUED — set it once, keep it
# stable, or accept a full re-issue when rotating. Empty means an empty salt
# (still one-way, but not recommended for production).
# Issue a key with POST /api/api-keys (needs apikey:manage), then call the API
# with `Authorization: Bearer s2v_...`. The plaintext is shown exactly once.
API_KEY_PEPPER=
# Default lifetime (days) for newly issued keys. Empty means "never expires".
API_KEY_DEFAULT_EXPIRES_DAYS=

# How often the worker sweeps expired Idempotency-Key rows, in seconds. The SDK
# attaches an Idempotency-Key to every mutating call, so this table grows with
# request volume unless it is swept. Requires rebuilding the worker image.
WORKER_PURGE_INTERVAL_SECONDS=300

# --- Outbound webhooks (V7.3) ------------------------------------------------
# Deliveries are drained by the worker, so changes here require rebuilding the
# worker image. WEBHOOK_DISPATCH_ENABLED=false turns the worker's webhook loop
# into a no-op for deployments that never subscribe. The retry schedule itself
# (max attempts, per-delivery state) lives on each outbox row, not here; these
# tune the HTTP exchange, the crash-recovery lease and the auto-pause threshold.
WEBHOOK_DISPATCH_ENABLED=true
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_LEASE_SECONDS=300
WEBHOOK_BACKOFF_BASE_SECONDS=30
WEBHOOK_BACKOFF_CAP_SECONDS=3600
WEBHOOK_DISABLE_AFTER_FAILURES=20
WEBHOOK_BATCH_SIZE=10

# --- Embeddable workspace (V7.4) --------------------------------------------
# Signing key for stateless embed links ("s2v_embed_<payload>.<hmac>"). The
# platform signs and the partner only holds the resulting link, so a host can
# never fabricate a session for a run it was not granted.
# CHANGING THIS INVALIDATES EVERY EMBED LINK IN FLIGHT — that is the intended
# emergency lever, the same stance API_KEY_PEPPER takes. Leave it empty for a
# single internal deployment; set it before any partner is onboarded.
EMBED_TOKEN_SECRET=
# How long a freshly minted link stays valid, and the ceiling a caller cannot
# exceed by asking. Short by default because the token lives in a URL; the
# ceiling exists so a careless caller cannot mint a month-long capability.
EMBED_TOKEN_DEFAULT_TTL_SECONDS=900
EMBED_TOKEN_MAX_TTL_SECONDS=86400

# --- Username-password sessions (V1.1) ---------------------------------------
# Optional. How long a login session stays usable without a re-prompt. The
# session token's stored digest mixes in API_KEY_PEPPER, so rotating that
# pepper invalidates API keys and login sessions together — one emergency
# lever for every bearer credential the platform issues.
SESSION_TTL_HOURS=72

# --- Worker scaling (V8.1) ---------------------------------------------------
# All optional; these are the deployment levers, the in-code defaults are safe.
# WORKER_ROLE=all
# WORKER_JOB_TIMEOUT_SECONDS=1800
# WORKER_RETRY_BACKOFF_BASE_SECONDS=30
# WORKER_RETRY_BACKOFF_CAP_SECONDS=3600

# --- Observability (V8.2) ----------------------------------------------------
# LOG_FORMAT=json switches every log line (API and worker) to one JSON object
# per line; the default "text" keeps the plain four-field format. LOG_LEVEL is
# the root logger level. /metrics is served by the API unauthenticated by
# design (scrapers have no actor identity) - keep the port off the public
# internet. WORKER_METRICS_PORT=0 disables the worker's metrics server.
LOG_FORMAT=text
LOG_LEVEL=INFO
WORKER_METRICS_PORT=0

# --- Security hardening (V8.4) ----------------------------------------------
# Encryption of provider secrets is OPT-IN. Empty SECRET_ENCRYPTION_KEY keeps
# the pre-V8.4 behaviour exactly: values are stored as they were given. Setting
# it moves secret material into the `encrypted_secrets` table as AES-256-GCM
# ciphertext, referenced from `provider_credentials.secret_values` by an opaque
# `sec_...` pointer. Any high-entropy string works (it is hashed to 256 bits);
# generate with `openssl rand -base64 32`.
# ROTATING THIS KEY REQUIRES RE-SEALING: after changing it, POST
# /api/provider-credentials/{id}/rotate for each credential (needs
# provider:manage). Until that is done those credentials report `locked` and
# their values are withheld from the tool environment.
SECRET_ENCRYPTION_KEY=

# Upload admission. The encoded length is checked before base64 decoding, so an
# oversized body is refused without being materialised. ASSET_ALLOWED_MIME_TYPES
# empty means "no allow-list, only the deny-list and the magic-number check".
ASSET_UPLOAD_MAX_BYTES=268435456
ASSET_ALLOWED_MIME_TYPES=

# Signed asset links. The TTL a caller asks for is capped at
# ASSET_LINK_MAX_TTL_SECONDS. Outside a local environment, minting is REFUSED
# while ASSET_LINK_SECRET is still the built-in development default - that value
# is public, so any link it signs can be forged.
ASSET_LINK_MAX_TTL_SECONDS=3600

# Provider callbacks. Empty means "accept unsigned" - the platform cannot decide
# on the upstream's behalf, and local runs have no shared secret. Set it to
# require `X-S2V-Signature: t=<unix>,v1=<hex>` (HMAC-SHA256 over "<t>.<body>",
# the same scheme as outbound webhooks); unsigned or stale calls then get 401.
PROVIDER_CALLBACK_SECRET=
PROVIDER_CALLBACK_TOLERANCE_SECONDS=300

# --- Deployment posture (V8.5) ---
# A label for dashboards and the deployment posture report. Nothing branches on
# it; empty reads back as the app name. Maintenance mode is deliberately NOT
# configured here - it lives in the `deployment_settings` table so it can be
# flipped while the deployment is being repaired, which is exactly when you
# cannot edit this file and restart.
DEPLOYMENT_NAME=

# The starting value for a new deployment's backup retention window, in days.
# It is a default for the row, not an enforcement: `scripts/backup.sh --keep N`
# decides what is actually pruned, and `deployment_preflight.py` warns when the
# last recorded backup is older than this. 0 disables the warning.
DEPLOYMENT_BACKUP_RETENTION_DAYS=14
